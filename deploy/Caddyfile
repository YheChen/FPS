# Caddy reverse proxy for the FPS dedicated server.
#
# Caddy terminates TLS (auto-provisioning a Let's Encrypt certificate) and
# transparently proxies the WebSocket upgrade to the plain ws:// game server
# on localhost. The browser client connects to wss://fps.yanzhenchen.ca; the
# C++ server never needs to know about TLS.
#
# Requires: a DNS A/AAAA record for the domain pointing at this host, and
# inbound TCP 443 -- plus 80 for the HTTP-01 challenge, unless you uncomment
# the DNS-01 block below. See docs/deploy.md.
#
# Install: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

fps.yanzhenchen.ca {
	reverse_proxy localhost:7778

	# --- DNS-01 certificates (docs/deploy.md, TLS path B) -----------------
	# Uncomment when inbound port 80 is blocked, which is common on a
	# residential connection. Caddy then proves domain control by writing a
	# DNS record instead of answering an HTTP challenge, so only 443 ever has
	# to be open.
	#
	# yanzhenchen.ca is on Porkbun, so this is Porkbun's API -- not
	# Cloudflare's. The packaged Caddy binary contains NEITHER; build one:
	#     xcaddy build --with github.com/caddy-dns/porkbun
	#
	# Porkbun issues a key/secret PAIR, and API access must be enabled per
	# domain in their panel (Domain Management > Details > API Access).
	# Both values come from a systemd drop-in rather than from this file, so
	# they are not world-readable in /etc/caddy.
	#
	# tls {
	# 	dns porkbun {
	# 		api_key {env.PORKBUN_API_KEY}
	# 		api_secret_key {env.PORKBUN_API_SECRET_KEY}
	# 	}
	# }
}
