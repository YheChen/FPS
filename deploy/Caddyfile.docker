# Caddyfile for the Docker Compose deployment (deploy/compose.yaml).
#
# Differs from the bare-metal deploy/Caddyfile in two ways: the domain comes
# from the environment rather than being edited in place, and the upstream is
# the compose service name instead of localhost.

{$FPS_DOMAIN} {
	reverse_proxy server:7778

	# --- DNS-01 certificates (docs/deploy.md, TLS path B) -----------------
	# Uncomment when inbound port 80 is blocked, which is common on a
	# residential connection. Caddy then proves domain control by writing a
	# DNS record instead of answering an HTTP challenge, so only 443 has to
	# be open -- and you can stop publishing 80 in compose.yaml.
	#
	# yanzhenchen.ca is on Porkbun, so this is Porkbun's API, not
	# Cloudflare's. The stock caddy:2-alpine image has NEITHER module. Build
	# one and point compose.yaml at it:
	#
	#     FROM caddy:2-builder AS builder
	#     RUN xcaddy build --with github.com/caddy-dns/porkbun
	#     FROM caddy:2-alpine
	#     COPY --from=builder /usr/bin/caddy /usr/bin/caddy
	#
	# Porkbun issues a key/secret PAIR, and API access must be enabled per
	# domain in their panel (Domain Management > Details > API Access).
	# compose passes both through from deploy/.env.
	#
	# tls {
	# 	dns porkbun {
	# 		api_key {env.PORKBUN_API_KEY}
	# 		api_secret_key {env.PORKBUN_API_SECRET_KEY}
	# 	}
	# }
}
