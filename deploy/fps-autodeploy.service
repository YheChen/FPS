# Redeploys the dedicated server when main moves. See docs/deploy.md.
#
# Paired with fps-autodeploy.timer -- oneshot, does nothing on its own:
#     sudo cp deploy/fps-autodeploy.* /etc/systemd/system/
#     sudo systemctl enable --now fps-autodeploy.timer
#
# User= must be the account that owns the clone AND is in the `docker` group.
# Edit it and the paths below if yours differs.
#
# INSTALL THE SCRIPT TO /opt, NOT FROM THE CLONE. On a SELinux host -- which
# Fedora is, enforcing, and which is the documented target -- a file under
# /home carries `user_home_t`, and systemd (init_t) is not permitted to
# execute that. Pointing ExecStart into the repo fails with a 203/EXEC and a
# bare "Permission denied" that names no cause and looks like a file mode:
#
#     sudo install -m 0755 tools/server_autodeploy.sh \
#          /opt/fps/tools/server_autodeploy.sh
#
# Only the executable needs moving. WorkingDirectory and FPS_REPO still point
# at the clone, which the script only reads and writes as the user.

[Unit]
Description=Redeploy the FPS dedicated server when main moves
Documentation=https://github.com/YheChen/FPS/blob/main/docs/deploy.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=yanzhen
WorkingDirectory=/home/yanzhen/GitHub/FPS
Environment=FPS_REPO=/home/yanzhen/GitHub/FPS
# Spelled out rather than left to the script's ~/.local/state default, so that
# this unit and a hand-run of the same script read the SAME deploy stamp. If
# they disagreed, running it by hand would report a different idea of what is
# deployed than the timer has -- which is the class of bug this file exists to
# stop.
Environment=FPS_STATE_DIR=/home/yanzhen/.local/state/fps
ExecStart=/opt/fps/tools/server_autodeploy.sh

# Exit 2 is the script DECLINING to act: the protocol guard refusing to ship a
# server no published client could join, or the backoff after five failed
# recovery attempts. Both are correct, expected and RECURRING outcomes -- the
# guard is the answer every ten minutes for as long as the client lags behind
# -- so they must not leave the unit sitting in "failed", where it would be
# permanent red in systemctl and a page for anything watching. Exit 1 stays a
# real failure.
SuccessExitStatus=2

# A build is minutes, not seconds, and the timer must not stack another run on
# top of one already going.
TimeoutStartSec=1800

# Deliberately NOT sandboxed the way porkbun-ddns.service is. That unit makes
# two HTTPS calls and can afford ProtectHome=true; this one drives git and
# docker against a clone in the user's home directory, so ProtectHome would
# make the repo invisible and ProtectSystem=strict would break the docker
# socket. Locking this down means moving the clone out of /home and running
# the build as a dedicated service account -- worth doing, not pretended at
# here with directives that would only look reassuring.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
